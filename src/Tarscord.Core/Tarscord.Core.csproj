<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Tarscord.Core</AssemblyName>
    <RootNamespace>Tarscord.Core</RootNamespace>
    <Title>Tarscord</Title>
    <Authors>Armend Ukëhaxhaj</Authors>
    <Copyright>Armend Ukëhaxhaj</Copyright>
    <PackageProjectUrl>https://github.com/armendu/Tarscord</PackageProjectUrl>
    <PackageLicenseUrl>https://github.com/armendu/Tarscord/blob/master/LICENSE</PackageLicenseUrl>
    <RepositoryUrl>https://github.com/armendu/Tarscord</RepositoryUrl>
    <PackageTags>.NET</PackageTags>
    <Prefer32Bit>false</Prefer32Bit>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tarscord.Core.Tests" />
    <InternalsVisibleTo Include="Tarscord.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Pinned: OllamaSharp 5.4.x ships a source generator built against a newer Roslyn than the
         10.0.201 SDK's compiler, which warns CS9057 in every project that sees it. -->
    <PackageReference Include="OllamaSharp" Version="5.3.1" />
    <PackageReference Include="OneOf" Version="3.0.271" />
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup>
    <!-- config.example.yml is the always-present defaults layer, config.yml the gitignored
         override; Startup reads them in that order, so a fresh clone starts and fails with a
         readable "enter your token" message instead of a FileNotFoundException. -->
    <None Update="Resources\config.example.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\config.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
