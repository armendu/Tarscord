# Declared so editors stop guessing: the tree is UTF-8 without a BOM throughout.
# Only encoding and whitespace are set here. No IDExxxx severities, so this changes
# nothing about what the build enforces.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,slnx,props,targets}]
indent_size = 2

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
